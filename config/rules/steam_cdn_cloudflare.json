{
  "schema_version": 1,
  "id": "steam_cdn_cloudflare",
  "name": "Steam 页面布局/图片修复 (Cloudflare)",
  "group": "steam",
  "description": "Cloudflare 前缀的 steamstatic 域名走 dogfight360 的 stdns 上游（TLS SNI 保持真实域名）。",
  "enabled": true,
  "sites": [
    {
      "hosts": [
        "cdn.cloudflare.steamstatic.com",
        "community.cloudflare.steamstatic.com",
        "store.cloudflare.steamstatic.com",
        "avatars.cloudflare.steamstatic.com",
        "clan.cloudflare.steamstatic.com",
        "shared.cloudflare.steamstatic.com",
        "video.cloudflare.steamstatic.com"
      ],
      "pna_cors": true,
      "prefer": {
        "mode": "cf",
        "cidrs": [
          "173.245.48.0/20",
          "103.21.244.0/22",
          "103.22.200.0/22",
          "103.31.4.0/22",
          "141.101.64.0/18",
          "108.162.192.0/18",
          "190.93.240.0/20",
          "188.114.96.0/20",
          "197.234.240.0/22",
          "198.41.128.0/17",
          "162.158.0.0/15",
          "104.16.0.0/12",
          "172.64.0.0/17",
          "172.64.128.0/18",
          "172.64.192.0/19",
          "172.64.224.0/22",
          "172.64.229.0/24",
          "172.64.230.0/23",
          "172.64.232.0/21",
          "172.64.240.0/21",
          "172.64.248.0/21",
          "172.65.0.0/16",
          "172.66.0.0/16",
          "172.67.0.0/16",
          "131.0.72.0/22"
        ]
      },
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": ["https://stdns.dogfight360.com"],
          "transport": { "tls": true, "tls_server_name": "{host}", "insecure_skip_verify": false },
          "header_up": [["Host", "{host}"]]
        }
      ]
    }
  ]
}