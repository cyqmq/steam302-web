{
 "schema_version": 1,
 "id": "steam_cdn_cloudflare",
 "name": "Steam 页面布局/图片修复 (steamstatic)",
 "group": "steam",
 "description": "cloudflare 前缀的 steamstatic 域名走 Steam 的 Akamai 节点上游（与 store/community 同款）。CF 优选曾直连 CF 边缘，但边缘对大陆 IP 一律 403，故改为 Akamai 节点模式。",
 "enabled": true,
 "sites": [
  {
   "hosts": [
    "cdn.cloudflare.steamstatic.com",
    "community.cloudflare.steamstatic.com",
    "store.cloudflare.steamstatic.com",
    "avatars.cloudflare.steamstatic.com",
    "clan.cloudflare.steamstatic.com",
    "shared.cloudflare.steamstatic.com",
    "video.cloudflare.steamstatic.com"
   ],
   "pna_cors": true,
   "prefer": {
    "mode": "node",
    "validate": true,
    "validate_path": "/favicon.ico",
    "top_n": 2
   },
   "handlers": [
    {
     "type": "reverse_proxy",
     "upstreams": [
      "https://steamuserimages-a.akamaihd.net.edgesuite.net",
      "https://steamstore-a.akamaihd.net.edgesuite.net",
      "https://eaassets-a.akamaihd.net.edgesuite.net",
      "https://steamcommunity-a.akamaihd.net.edgesuite.net"
     ],
     "dynamic_upstreams": [
      {
       "dns": "a",
       "host": "steamuserimages-a.akamaihd.net.edgesuite.net",
       "port": 443
      },
      {
       "dns": "a",
       "host": "steamstore-a.akamaihd.net.edgesuite.net",
       "port": 443
      },
      {
       "dns": "a",
       "host": "eaassets-a.akamaihd.net.edgesuite.net",
       "port": 443
      },
      {
       "dns": "a",
       "host": "steamcommunity-a.akamaihd.net.edgesuite.net",
       "port": 443
      }
     ],
     "lb": {
      "policy": "random_choose",
      "choose": 4,
      "try_duration": "5s"
     },
     "transport": {
      "tls": true,
      "tls_server_name": "img-s-msn-com.akamaized.net",
      "insecure_skip_verify": false
     },
     "header_up": [
      [
       "Host",
       "{host}"
      ]
     ]
    }
   ]
  }
 ]
}