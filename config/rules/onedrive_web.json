{
  "schema_version": 1,
  "id": "onedrive_web",
  "name": "OneDrive 网页版",
  "group": "misc",
  "description": "onedrive.live.com 主页与 skyapi.onedrive.live.com 反代到微软官方 edge IP 池，修复国内 OneDrive 网页访问。",
  "enabled": false,
  "sites": [
    {
      "hosts": ["onedrive.live.com"],
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": ["https://13.107.42.13"],
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "onedrive.live.com"]]
        }
      ]
    },
    {
      "hosts": ["skyapi.onedrive.live.com"],
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://131.253.14.227",
            "https://131.253.14.229",
            "https://40.90.136.179",
            "https://13.105.28.48",
            "https://40.90.136.180",
            "https://157.55.109.228",
            "https://40.90.136.163",
            "https://131.253.14.230",
            "https://40.90.128.17",
            "https://40.90.142.226",
            "https://13.105.28.32",
            "https://104.44.88.24"
          ],
          "lb": { "policy": "random_choose", "choose": 6, "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "skyapi.onedrive.live.com"]]
        }
      ]
    }
  ]
}