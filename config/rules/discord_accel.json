{
  "schema_version": 1,
  "id": "discord_accel",
  "name": "Discord 图片/附件修复",
  "group": "chat",
  "description": "discord 全系本地接管：主站/API 直连 Cloudflare 边缘 IP，图片媒体/附件分别走 GCS 与专用节点，去 Cookie 保持干净。",
  "enabled": false,
  "sites": [
    {
      "hosts": [
        "discord.com",
        "updates.discord.com",
        "status.discord.com",
        "streamkit.discord.com",
        "feedback.discord.com",
        "click.discord.com",
        "pax.discord.com",
        "printer.discord.com",
        "ptb.discord.com",
        "canary.discord.com",
        "bugs.discord.com",
        "i18n.discord.com"
      ],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "match": { "path": ["/assets/*"] },
          "upstreams": ["https://dldsn.steam302.xyz"],
          "transport": { "tls": true, "insecure_skip_verify": false },
          "header_up": [
            ["Host", "dldsn.steam302.xyz"],
            ["Cookie", null]
          ],
          "header_down": [["Set-Cookie", null], ["Cookie", null]]
        },
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://162.159.138.232",
            "https://162.159.135.232",
            "https://162.159.137.232",
            "https://162.159.128.233",
            "https://162.159.136.232"
          ],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": [
        "discordapp.com",
        "url9177.discordapp.com",
        "canary-api.discordapp.com",
        "cdn-ptb.discordapp.com",
        "ptb.discordapp.com",
        "status.discordapp.com",
        "cdn-canary.discordapp.com",
        "cdn.discordapp.com",
        "streamkit.discordapp.com",
        "i18n.discordapp.com",
        "url9624.discordapp.com",
        "url7195.discordapp.com",
        "merch.discordapp.com",
        "printer.discordapp.com",
        "canary.discordapp.com",
        "apps.discordapp.com",
        "pax.discordapp.com"
      ],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://162.159.133.233",
            "https://162.159.129.233",
            "https://162.159.130.233",
            "https://162.159.134.233",
            "https://162.159.135.233"
          ],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": ["gateway.discord.gg", "discord.gg"],
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://162.159.136.234",
            "https://162.159.134.234",
            "https://162.159.135.234",
            "https://162.159.133.234",
            "https://162.159.130.234"
          ],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": ["media.discordapp.net"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://162.159.133.232",
            "https://162.159.134.232",
            "https://162.159.129.232",
            "https://162.159.130.232",
            "https://162.159.128.232"
          ],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": ["images-ext-1.discordapp.net", "images-ext-2.discordapp.net"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "redir",
          "redir": { "to": "https://media.discordapp.net{uri}", "permanent": true }
        }
      ]
    },
    {
      "hosts": ["dl.discordapp.net"],
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": ["https://dlds.steam302.xyz"],
          "transport": { "tls": true, "insecure_skip_verify": false },
          "header_up": [
            ["Host", "dlds.steam302.xyz"],
            ["Cookie", null]
          ],
          "header_down": [["-Set-Cookie", null], ["-Cookie", null]]
        }
      ]
    },
    {
      "hosts": ["discord-attachments-uploads-prd.storage.googleapis.com"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": ["https://storage.googleapis.com"],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "tls_server_name": "uploads", "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": ["support.discord.com", "safety.discord.com", "support-dev.discord.com"],
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": ["https://supportds.steam302.xyz", "https://safetyds.steam302.xyz", "https://support-devds.steam302.xyz"],
          "lb": { "policy": "random" },
          "transport": { "tls": true, "insecure_skip_verify": false },
          "header_up": [["Host", "{host}"]]
        }
      ]
    }
  ]
}