{
  "schema_version": 1,
  "id": "steam_community",
  "name": "Steam 社区解锁",
  "group": "steam",
  "description": "浏览器/客户端访问 steamcommunity.com，评论区/论坛经 steam302 节点并伪装 Googlebot UA；图片/素材走 Akamai 边缘(SNI 伪装)。",
  "enabled": true,
  "sites": [
    {
      "hosts": ["steamcommunity.com", "www.steamcommunity.com"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "match": {
            "path": [
              "/comment/*",
              "/forum/*",
              "*discussions*",
              "*tradingforum*",
              "*eventcomments*",
              "/chat/beginfileupload/*"
            ]
          },
          "upstreams": [
            "https://str001.steam302.xyz",
            "https://str002.steam302.xyz",
            "https://str003.steam302.xyz",
            "https://str004.steam302.xyz"
          ],
          "lb": { "policy": "random_choose", "choose": 3, "fail_duration": "3s", "max_fails": 3, "unhealthy_latency": "1000ms", "unhealthy_status": "5xx" },
          "transport": { "tls": true, "tls_server_name": "statuspage.akamaized.net", "insecure_skip_verify": false },
          "header_up": [
            ["Host", "steamcommunity.com"],
            ["User-Agent", ".*", "$0 Googlebot/2.1 (+http://www.google.com/bot.html)"]
          ]
        },
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://steamuserimages-a.akamaihd.net.edgesuite.net",
            "https://steamstore-a.akamaihd.net.edgesuite.net",
            "https://eaassets-a.akamaihd.net.edgesuite.net",
            "https://steamcommunity-a.akamaihd.net.edgesuite.net"
          ],
          "dynamic_upstreams": [
            { "dns": "a", "host": "steamuserimages-a.akamaihd.net.edgesuite.net", "port": 443 },
            { "dns": "a", "host": "steamstore-a.akamaihd.net.edgesuite.net", "port": 443 },
            { "dns": "a", "host": "eaassets-a.akamaihd.net.edgesuite.net", "port": 443 },
            { "dns": "a", "host": "steamcommunity-a.akamaihd.net.edgesuite.net", "port": 443 }
          ],
          "lb": { "policy": "random_choose", "choose": 4, "try_duration": "5s" },
          "transport": { "tls": true, "tls_server_name": "img-s-msn-com.akamaized.net", "insecure_skip_verify": false },
          "header_up": [
            ["Host", "steamcommunity.com"],
            ["User-Agent", ".*", "$0 Googlebot/2.1 (+http://www.google.com/bot.html)"]
          ]
        }
      ]
    }
  ]
}