{
  "schema_version": 1,
  "id": "pixiv_accel",
  "name": "Pixiv 直连",
  "group": "image",
  "description": "pixiv 全系：主站/API 直连日本源站 IP 池，图片走 i.pximg 专用池，TLS 不校验以避免证书链问题。",
  "enabled": false,
  "sites": [
    {
      "hosts": [
        "pixiv.net",
        "www.pixiv.net",
        "m.pixiv.net",
        "touch.pixiv.net",
        "accounts.pixiv.net",
        "app-api.pixiv.net",
        "oauth.secure.pixiv.net",
        "public-api.secure.pixiv.net",
        "recommend-api.pixiv.net",
        "embed.pixiv.net",
        "dic.pixiv.net",
        "en.dic.pixiv.net",
        "help.pixiv.net",
        "fanbox.cc",
        "www.fanbox.cc",
        "api.fanbox.cc",
        "fanbox.pixiv.net"
      ],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
          "upstreams": [
            "https://210.140.92.186",
            "https://210.140.92.187",
            "https://210.140.92.183",
            "https://210.140.92.181",
            "https://210.140.92.179",
            "https://210.140.92.182"
          ],
          "lb": { "policy": "random", "try_duration": "5s" },
          "transport": { "tls": true, "insecure_skip_verify": true },
          "header_up": [["Host", "{host}"]]
        }
      ]
    },
    {
      "hosts": ["i.pximg.net", "s.pximg.net"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "reverse_proxy",
