{
  "schema_version": 1,
  "id": "youtube_iframe",
  "name": "Steam 创意工坊大图修复 (YouTube iframe)",
  "group": "steam",
  "description": "创意工坊内嵌 YouTube 大图修复：本地提供修复用的 iframe_api 脚本，其余路径返回提示文案（避免误代理整个 YouTube）。",
  "enabled": true,
  "needs_files": ["web/files/iframe/iframe_api", "web/files/iframe/iframe_api.js"],
  "sites": [
    {
      "hosts": ["www.youtube.com"],
      "pna_cors": true,
      "handlers": [
        {
          "type": "file_server",
          "match": { "path": ["/iframe_api", "/iframe_api.js"] },
          "file_server": { "root": "web/files/iframe", "browse": false }
        },
        {
          "type": "respond",
          "match": {
            "not": [
              { "path": ["/iframe_api", "/iframe_api.js"] }
            ]
          },
          "respond": {
            "status": 200,
            "body": "www.youtube.com 已被本地的 Steam 创意工坊大图修复功能占用；关闭该功能可恢复正常访问。"
          }
        }
      ]
    }
  ]
}