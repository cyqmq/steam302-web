            "https://140.82.112.3",
            "https://140.82.114.4",
            "https://20.205.243.166",
            "https://20.27.177.113",
            "https://203.98.7.65"
          ],
          "lb": {
            "fail_duration": "30s",
            "max_fails": 2,
            "policy": "random",
            "try_duration": "10s"
          },
          "transport": {
            "dial_timeout": "3s",
            "tls": true,
            "insecure_skip_verify": true,
            "tls_server_name": "{host}"
          },
          "header_up": [
            [
              "Host",
              "{host}"
            ]
          ]
        }
